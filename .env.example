# Минимум 32 символа для production
SECRET_KEY=replace-with-long-random-secret-key-32chars

# SQLite (локально)
DATABASE_URL=sqlite:///./hotel.db

# PostgreSQL (Docker)
# DATABASE_URL=postgresql+psycopg2://hotel:hotel_secret@localhost:5432/hotel_db

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Запись в /items (POST, PUT, DELETE) — как X-API-Key в MetLab12
API_KEY=change-me-for-local-dev
